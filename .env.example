# Telegram Botfather tokeni
BOT_TOKEN=

# my.telegram.org dan olingan API ma'lumotlari
API_ID=
API_HASH=

# Xabar yuboriladigan shaxsiy akkaunt telefon raqami
PHONE_NUMBER=

# Botingizga faqat siz kira olishingiz uchun sizning Telegram ID raqamingiz
ADMIN_ID=

# Render.com kabi hostinglar uchun StringSession (login_helper beradi)
SESSION_STRING=

# Har bir xabar orasidagi kutish vaqti (soniyalarda, tavsiya: 15-30)
DELAY_MIN=15
DELAY_MAX=30
